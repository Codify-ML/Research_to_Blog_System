# Copy to ops/dev.bootstrap.env and fill values before running bootstrap_env.py

# Core environment identity
AWS_PROFILE=personal-aws-dev
AWS_REGION=us-west-2
PROJECT_NAME=vc-blog-agent
CLOUD_ENV=dev

# DNS and routing
ROUTE53_ZONE_NAME=dev.vc-projects-ds.com
ROUTE53_ZONE_ID=Z03707592Y0NKCCWRSSFL
APP_DNS_PREFIX=blog-agent
API_DNS_LABEL=api
UI_DNS_LABEL=ui
LANGFUSE_DNS_LABEL=langfuse
COGNITO_DOMAIN_PREFIX=vc-blog-agent-dev-auth

# GitHub environment sync
GITHUB_ENVIRONMENT=dev
# Optional, defaults to current gh repo context
GITHUB_REPO=
TF_WORKDIR=infra/terraform/envs/dev
IMAGE_PLATFORM=linux/amd64
AWS_ROLE_TO_ASSUME=
# Optional
AWS_ROLE_EXTERNAL_ID=

# App secrets (AWS + GitHub)
OPENAI_API_KEY=
API_AUTH_KEY=

# App-to-Langfuse tracing secrets
# Optional. If empty, bootstrap auto-generates lf_pk_/lf_sk_ values
# (or reuses existing values from AWS Secrets Manager).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse datastore/connectivity
LANGFUSE_DATABASE_URL=
LANGFUSE_REDIS_URL=
# Optional overrides
LANGFUSE_CLICKHOUSE_USER=default
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse
# Optional, auto-derived when empty:
# clickhouse.<project>-<env>.internal
LANGFUSE_CLICKHOUSE_HOST=
LANGFUSE_CLICKHOUSE_URL=
LANGFUSE_CLICKHOUSE_MIGRATION_URL=

# Langfuse app/auth bootstrap
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
# Required when ENABLE_LANGFUSE_BOOTSTRAP_INIT=true
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=vc-blog-agent-observability

# Optional generated if left empty
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=

# Terraform defaults to render
ENABLE_HTTPS=true
ENABLE_UI_AUTH=true
API_AUTH_ENABLED=true
APP_LANGFUSE_ENABLED=true
APP_LANGFUSE_HOST=https://langfuse.blog-agent.dev.vc-projects-ds.com
APP_LANGFUSE_ENVIRONMENT=dev
APP_LANGFUSE_SAMPLE_RATE=1.0
APP_LANGFUSE_CAPTURE_CONTENT=false
APP_LANGFUSE_TRACE_HEALTH_ENDPOINTS=false

ENABLE_LANGFUSE_COMPUTE=true
ENABLE_LANGFUSE_AUTH=true
LANGFUSE_AUTH_DISABLE_SIGNUP=true
ENABLE_LANGFUSE_BOOTSTRAP_INIT=true
LANGFUSE_TELEMETRY_ENABLED=false
