# Core runtime
CHECKPOINTER=memory

# LLM provider mode
USE_MOCK_LLM=true
MOCK_MODE_STRICT=false

# OpenAI (required when USE_MOCK_LLM=false)
OPENAI_API_KEY=
OPENAI_MODEL_RESEARCHER=gpt-4.1
OPENAI_MODEL_WRITER=gpt-4.1-mini
OPENAI_MODEL_EDITOR=gpt-4.1-mini

# Data stores (Phase 2+)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_blog

# Async worker/runtime (Phase 2+)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JOB_STORE_PATH=./var/jobs.db

# Retry tuning
LLM_MAX_RETRIES=3
LLM_BASE_BACKOFF_SECONDS=0.2
LLM_MAX_BACKOFF_SECONDS=2.0
