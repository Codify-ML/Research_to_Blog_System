# Core runtime
CHECKPOINTER=memory

# LLM provider mode
USE_MOCK_LLM=true
MOCK_MODE_STRICT=false

# OpenAI (required when USE_MOCK_LLM=false)
OPENAI_API_KEY=
OPENAI_MODEL_RESEARCHER=gpt-4.1
OPENAI_MODEL_WRITER=gpt-4.1-mini
OPENAI_MODEL_EDITOR=gpt-4.1-mini
RESEARCH_WEB_SEARCH_ENABLED=true
RESEARCH_FUNCTION_TOOLS_ENABLED=true
SAFETY_ENABLED=true
SAFETY_FAIL_CLOSED=false
SAFETY_PROFANITY_ENABLED=true
SAFETY_HATE_CONTENT_ENABLED=true
SAFETY_PROMPT_INJECTION_ENABLED=true
SAFETY_SENSITIVE_DATA_ENABLED=true
SAFETY_OPENAI_MODERATION_ENABLED=true
SAFETY_EXPLAIN_ENABLED=true
SAFETY_OPENAI_MODERATION_MODEL=omni-moderation-latest
SAFETY_MODERATION_SCORE_THRESHOLD=0.65
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERATE_PER_MINUTE=20
RATE_LIMIT_STATUS_PER_MINUTE=120
ABUSE_WINDOW_SECONDS=600
ABUSE_VIOLATION_THRESHOLD=5
ABUSE_COOLDOWN_SECONDS=900
RATE_LIMIT_FAIL_OPEN=true
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_ENVIRONMENT=local
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_TRACE_HEALTH_ENDPOINTS=true

# API shared-key auth
API_AUTH_ENABLED=false
API_AUTH_KEY=

# Data stores (Phase 2+)
REDIS_URL=redis://localhost:6379/0
# Either set DATABASE_URL, or set DB_* + DB_PASSWORD.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_blog
DB_HOST=localhost
DB_PORT=5432
DB_NAME=research_blog
DB_USER=postgres
DB_PASSWORD=

# Async worker/runtime (Phase 2+)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
JOB_STORE_BACKEND=sqlite
JOB_STORE_PATH=./var/jobs.db

# Retry tuning
LLM_MAX_RETRIES=3
LLM_BASE_BACKOFF_SECONDS=0.2
LLM_MAX_BACKOFF_SECONDS=2.0

# UI (Phase 3+)
UI_API_BASE_URL=http://127.0.0.1:8000
UI_POLL_INTERVAL_SECONDS=1.0
UI_REQUEST_TIMEOUT_SECONDS=10.0
UI_COGNITO_HOSTED_UI_BASE=
UI_COGNITO_CLIENT_ID=
UI_PUBLIC_BASE_URL=http://127.0.0.1:8501
