# Copy to terraform.tfvars and update for your AWS account.
# Never commit populated terraform.tfvars files.

aws_region = "us-west-2"
aws_profile = "personal-aws-dev"
project_name = "vc-blog-agent"
route53_zone_name = "dev.vc-projects-ds.com"
route53_zone_id = "Z03707592Y0NKCCWRSSFL"
# Naming convention:
# if project_name starts with "vc-", app_dns_prefix should be project_name
# without that prefix (vc-blog-agent -> blog-agent).
app_dns_prefix = "blog-agent"
api_dns_label = "api"
ui_dns_label = "ui"
cognito_domain_prefix = "vc-blog-agent-dev-auth"
enable_https = true
enable_ui_auth = true

# Optional full host overrides. Leave empty to use derived hostnames:
#   <api_dns_label>.<app_dns_prefix>.<route53_zone_name>
#   <ui_dns_label>.<app_dns_prefix>.<route53_zone_name>
api_hostname = ""
ui_hostname = ""

# Deprecated/unused: RDS master password is now managed by AWS Secrets
# Manager.
# db_password = ""

# Optional bootstrap values. If empty, Terraform creates the Secrets Manager
# secret and you can set the value manually afterward.
openai_api_key = ""
api_auth_key = ""
langfuse_public_key = ""
langfuse_secret_key = ""
api_auth_enabled = false

# If you set api_auth_enabled=true, also provide api_auth_key (or
# TF_VAR_api_auth_key) before plan/apply.

# Network posture for cloud portability.
enable_nat_gateway = true
waf_rate_limit = 2000

# Redis safety defaults.
redis_parameter_group_family = "redis7"
redis_maxmemory_policy = "noeviction"

# ECS resiliency and rolling deployment safety.
api_desired_count = 2
worker_desired_count = 2
ui_desired_count = 2
ui_logout_desired_count = 2
deployment_minimum_healthy_percent = 100
deployment_maximum_percent = 200
enable_deployment_circuit_breaker = true

# If left empty, Terraform composes image URIs from created ECR repos
# using `image_tag`.
api_image = ""
worker_image = ""
ui_image = ""
image_tag = "latest"

# Runtime defaults.
use_mock_llm = false
mock_mode_strict = false

# API abuse/rate-limiting defaults.
rate_limit_enabled = true
rate_limit_generate_per_minute = 20
rate_limit_status_per_minute = 120
abuse_window_seconds = 600
abuse_violation_threshold = 5
abuse_cooldown_seconds = 900
rate_limit_fail_open = true

# Langfuse tracing (API/worker). Set keys as secret values above.
langfuse_enabled = false
langfuse_host = "https://langfuse.blog-agent.dev.vc-projects-ds.com"
langfuse_environment = "dev"
langfuse_sample_rate = 1.0
langfuse_capture_content = false
langfuse_trace_health_endpoints = false
