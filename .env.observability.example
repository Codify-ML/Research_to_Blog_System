# Langfuse self-hosted local stack settings.
# Copy to .env.observability and change values before first run.

LANGFUSE_PUBLIC_URL=http://127.0.0.1:3000
LANGFUSE_TELEMETRY_ENABLED=false

# SALT and NEXTAUTH secret should be 32+ random characters.
LANGFUSE_SALT=replace-with-32-char-random-salt
# Must be exactly 64 hex chars (256-bit), e.g. openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-chars
LANGFUSE_NEXTAUTH_SECRET=replace-with-32-char-random-secret

LANGFUSE_MINIO_ACCESS_KEY=minioadmin
LANGFUSE_MINIO_SECRET_KEY=minioadmin123
LANGFUSE_REDIS_PASSWORD=change-me-redis-password
LANGFUSE_CLICKHOUSE_CLUSTER_ENABLED=false
LANGFUSE_CLICKHOUSE_DB=default
LANGFUSE_CLICKHOUSE_USER=default
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse
